<?xml version="1.0"?>
<ruleset name="Barrierepruefung WordPress-Plugin">
    <description>Sicherheits- und i18n-Regeln des WordPress-Standards, ohne dessen Formatierungsregeln.</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <config name="minimum_wp_version" value="6.5"/>
    <config name="testVersion" value="8.1-"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.AlternativeFunctions"/>
    <rule ref="WordPress.WP.EnqueuedResources"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="a11y-checker"/>
        </properties>
    </rule>

    <rule ref="PHPCompatibilityWP"/>
</ruleset>
