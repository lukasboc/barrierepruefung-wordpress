#: includes/class-a11y-checker-admin.php:44
#: includes/class-a11y-checker-admin.php:45 views/admin-page.php:27
msgid "Barrierefreiheit"
msgstr "Accessibility"

#: includes/class-a11y-checker-admin.php:55
msgid "Sie haben keine Berechtigung für diese Seite."
msgstr "You do not have permission to view this page."

#: includes/class-a11y-checker-admin.php:250
msgid "Sie haben keine Berechtigung für diese Aktion."
msgstr "You do not have permission to perform this action."

#: includes/class-a11y-checker-client.php:65
msgid "Das Plugin ist noch nicht mit einem Konto verbunden."
msgstr "The plugin is not connected to an account yet."

#: includes/class-a11y-checker-client.php:94
msgid "Unbekannter Fehler."
msgstr "Unknown error."

#: includes/class-a11y-checker-shortcode.php:43
msgid "Die Erklärung zur Barrierefreiheit kann gerade nicht geladen werden."
msgstr "The accessibility statement cannot be loaded at the moment."

#. translators: 1: Versionsnummer, 2: Datum
#: includes/class-a11y-checker-shortcode.php:61
#, php-format
msgid "Version %1$s, Stand %2$s"
msgstr "Version %1$s, as of %2$s"

#: includes/class-a11y-checker-shortcode.php:92
msgid "Erklärung zur Barrierefreiheit"
msgstr "Accessibility statement"

#: views/admin-page.php:16
msgid "Verbindung hergestellt. Bestätigen Sie jetzt die Domain."
msgstr "Connected. Please verify the domain now."

#: views/admin-page.php:17
msgid "Die Domain ist bestätigt."
msgstr "The domain is verified."

#: views/admin-page.php:18
msgid "Die Domain konnte nicht bestätigt werden."
msgstr "The domain could not be verified."

#: views/admin-page.php:19
msgid ""
"Die Prüfung wurde gestartet. Das Ergebnis steht in wenigen Minuten bereit."
msgstr "The scan has started. The result will be ready in a few minutes."

#: views/admin-page.php:20
msgid "Der Status wurde neu abgerufen."
msgstr "The status has been refreshed."

#: views/admin-page.php:21
msgid ""
"Die Verbindung wurde getrennt. Token, Website-Kennung und der gespeicherte "
"Text der Erklärung wurden entfernt."
msgstr ""
"The connection has been removed. Token, site ID and the stored text of the "
"statement were deleted."

#: views/admin-page.php:22
msgid "Die Adresse des Dienstes steht wieder auf dem Standardwert."
msgstr "The service address is back to its default value."

#: views/admin-page.php:23
msgid "Es ist ein Fehler aufgetreten."
msgstr "An error occurred."

#: views/admin-page.php:41
msgid "Mit Ihrem Konto verbinden"
msgstr "Connect to your account"

#: views/admin-page.php:43
msgid ""
"Legen Sie im Konto ein API-Token für diese Website an und tragen Sie es hier "
"ein."
msgstr "Create an API token for this site in your account and enter it here."

#: views/admin-page.php:52 views/admin-page.php:312
msgid "Adresse des Dienstes"
msgstr "Service address"

#. translators: %s: Standardadresse des Dienstes
#: views/admin-page.php:62
#, php-format
msgid "Standard: %s"
msgstr "Default: %s"

#: views/admin-page.php:69
msgid "API-Token"
msgstr "API token"

#: views/admin-page.php:73
msgid "Das Token gilt nur für diese Website."
msgstr "The token is valid for this site only."

#: views/admin-page.php:78 views/admin-page.php:316
msgid "Website-Kennung"
msgstr "Site ID"

#: views/admin-page.php:83
msgid "Verbinden"
msgstr "Connect"

#: views/admin-page.php:92
msgid "Adresse auf den Standardwert zurücksetzen"
msgstr "Reset address to the default value"

#: views/admin-page.php:96
msgid "Status"
msgstr "Status"

#: views/admin-page.php:99
msgid ""
"Die Website konnte nicht abgerufen werden. Prüfen Sie Token und Kennung."
msgstr ""
"The site could not be retrieved. Please check the token and the site ID."

#: views/admin-page.php:106
msgid "Status dieser Website"
msgstr "Status of this site"

#: views/admin-page.php:109
msgid "Adresse"
msgstr "Address"

#: views/admin-page.php:113
msgid "Domain bestätigt"
msgstr "Domain verified"

#: views/admin-page.php:116
msgid "nein"
msgstr "no"

#: views/admin-page.php:117
msgid "ja"
msgstr "yes"

#: views/admin-page.php:121
msgid "Nächste Prüfung"
msgstr "Next scan"

#: views/admin-page.php:124
msgid "nicht geplant"
msgstr "not scheduled"

#: views/admin-page.php:136
msgid "Domain jetzt bestätigen"
msgstr "Verify domain now"

#: views/admin-page.php:142
msgid "Jetzt prüfen"
msgstr "Scan now"

#: views/admin-page.php:151
msgid "Status aktualisieren"
msgstr "Refresh status"

#: views/admin-page.php:157
msgid ""
"Eine Prüfung läuft gerade. Das Ergebnis steht in wenigen Minuten bereit — "
"wählen Sie dann „Status aktualisieren\"."
msgstr "A scan is currently running. The result will be ready in a few minutes — then choose “Refresh status”."

#: views/admin-page.php:161
msgid "Kontingent"
msgstr "Quota"

#: views/admin-page.php:165
msgid "Das Kontingent konnte nicht abgerufen werden."
msgstr "The quota could not be retrieved."

#: views/admin-page.php:168
msgid "Geprüfte Seiten im laufenden Abrechnungszeitraum"
msgstr "Pages scanned in the current billing period"

#: views/admin-page.php:171
msgid "Geprüfte Seiten in diesem Zeitraum"
msgstr "Pages scanned in this period"

#. translators: %s: Anzahl geprüfter Seiten
#: views/admin-page.php:177
#, php-format
msgid "%s (unbegrenzt)"
msgstr "%s (unlimited)"

#. translators: 1: verbrauchte Seiten, 2: enthaltene Seiten
#: views/admin-page.php:183
#, php-format
msgid "%1$s von %2$s"
msgstr "%1$s of %2$s"

#: views/admin-page.php:192
msgid "Verbleibend"
msgstr "Remaining"

#: views/admin-page.php:198
msgid "Zeitraum bis"
msgstr "Period ends"

#: views/admin-page.php:206
msgid "Befunde"
msgstr "Findings"

#: views/admin-page.php:214
msgid "kritisch"
msgstr "critical"

#: views/admin-page.php:215
msgid "schwer"
msgstr "serious"

#: views/admin-page.php:216
msgid "mittel"
msgstr "moderate"

#: views/admin-page.php:217
msgid "gering"
msgstr "minor"

#: views/admin-page.php:222
msgid ""
"Für diese Website liegt noch kein Prüfergebnis vor. Wählen Sie „Jetzt "
"prüfen\"."
msgstr "There is no scan result for this website yet. Choose “Scan now”."

#: views/admin-page.php:224
msgid "Die letzte Prüfung hat keine offenen Befunde ergeben."
msgstr "The last scan found no open findings."

#. translators: %s: Datum der letzten Prüfung
#: views/admin-page.php:229
#, php-format
msgid ""
"Offene Befunde der Prüfung vom %s. Beheben Sie sie in WordPress und starten "
"Sie danach eine neue Prüfung."
msgstr "Open findings from the scan on %s. Fix them in WordPress and then start a new scan."

#: views/admin-page.php:231
msgid "unbekannten Datum"
msgstr "unknown date"

#: views/admin-page.php:237
msgid "Offene Befunde je Regel"
msgstr "Open findings by rule"

#: views/admin-page.php:242
msgid "Schweregrad"
msgstr "Severity"

#: views/admin-page.php:243
msgid "Befund"
msgstr "Finding"

#: views/admin-page.php:244
msgid "Erfolgskriterium"
msgstr "Success criterion"

#: views/admin-page.php:245
msgid "Fundstellen"
msgstr "Occurrences"

#: views/admin-page.php:246
msgid "Betroffene Seiten"
msgstr "Affected pages"

#. translators: %s: Hinweis, wie der Befund zu beheben ist
#: views/admin-page.php:262
#, php-format
msgid "Behebung: %s"
msgstr "How to fix: %s"

#. translators: %s: Anzahl weiterer betroffener Seiten
#: views/admin-page.php:285
#, php-format
msgid "und %s weitere"
msgstr "and %s more"

#: views/admin-page.php:301
msgid "Vollständiger Bericht mit allen Fundstellen"
msgstr "Full report with all occurrences"

#: views/admin-page.php:307
msgid "Verbindung"
msgstr "Connection"

#: views/admin-page.php:309
msgid "Eingetragene Verbindung"
msgstr "Stored connection"

#: views/admin-page.php:324
msgid ""
"Trennen entfernt Token, Website-Kennung und den gespeicherten Text der "
"Erklärung aus dieser Installation; danach lassen sich die Angaben neu "
"eintragen. Im Konto bleibt alles bestehen, das Token gilt weiter — "
"widerrufen wird es dort."
msgstr ""
"Disconnecting removes the token, the site ID and the stored text of the "
"statement from this installation; you can then enter the details again. "
"Nothing changes in your account — the token stays valid and is revoked there."

#: views/admin-page.php:329
msgid "Verbindung trennen"
msgstr "Disconnect"

#: views/admin-page.php:332
msgid "Erklärung einbinden"
msgstr "Embed the statement"

#: views/admin-page.php:333
msgid ""
"Fügen Sie diesen Shortcode auf der Seite ein, die Ihre Erklärung zur "
"Barrierefreiheit tragen soll:"
msgstr ""
"Add this shortcode to the page that should carry your accessibility "
"statement:"

#: views/admin-page.php:336
msgid ""
"Optionen: teil=\"maengel\" oder teil=\"kontakt\" für einen einzelnen "
"Abschnitt, stand=\"nein\" ohne Datumszeile, ueberschrift=\"3\" zum Einpassen "
"in Ihre Überschriftenhierarchie."
msgstr ""
"Options: teil=\"maengel\" or teil=\"kontakt\" for a single section, "
"stand=\"nein\" to omit the date line, ueberschrift=\"3\" to fit your heading "
"hierarchy."

#: views/admin-page.php:339
msgid "Datenübertragung"
msgstr "Data transfer"

#: views/admin-page.php:341
msgid ""
"Dieses Plugin überträgt die Adresse dieser Website sowie das API-Token an "
"den oben eingetragenen Dienst, um Prüfungen auszulösen und die Erklärung "
"abzurufen. Es werden keine Inhalte Ihrer Nutzerinnen und Nutzer übermittelt."
msgstr ""
"This plugin sends the address of this site and the API token to the service "
"configured above in order to start scans and retrieve the statement. No "
"content belonging to your visitors is transmitted."
